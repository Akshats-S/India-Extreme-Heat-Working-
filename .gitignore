# Local Python artifacts and environments
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
.ipynb_checkpoints/

# Credentials and machine-local files
.env
.env.*
*.pem
*.key
secrets*
.DS_Store
Thumbs.db

# Generated artifacts are bundled by build_packages.py, not tracked here.
data/processed/*
!data/processed/.gitkeep
outputs/analysis/*
!outputs/analysis/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep

# Original IMD CSVs remain tracked; avoid accidental gridded-file additions.
*.nc
*.grd
